{
	"compilerOptions": {
		"target": "es2024",
		"module": "preserve",
		"moduleResolution": "bundler",
		"lib": ["es2024"],
		"types": ["./worker-configuration.d.ts", "node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"paths": {
			"#lib/*": ["../../src/lib/*"]
		}
	},
	"include": ["src", "../../scripts/stats"]
}
