{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "solo-stack-web",
	"compatibility_date": "2026-10-30",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Inherited by every environment: no public *.workers.dev or version/preview URLs,
	// not even for an accidental `wrangler deploy` without `--env`.
	"workers_dev": false,
	"preview_urls": false,
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	// Workers Cache only stores responses that set Cache-Control. Its key is the path
	// (not cookies or Accept-Language), which is why i18n uses the URL strategy.
	"cache": {
		"enabled": true
	},
	"dev": {
		"ip": "0.0.0.0",
		"port": 8787
	},
	// App storage (docs/ARCHITECTURE.md#database): D1 `DB` is the database of this app (Drizzle schema in
	// `src/lib/db/schema.ts`, migrations generated into `migrations/`), KV `KV` holds caches and snapshots
	// (e.g. the /stats snapshot `stats:v1`). One database and one namespace per app and environment.
	// The top-level bindings are for local dev only (`pnpm dev`, `pnpm preview`, `--local`): they are simulated
	// in `.wrangler/state`, so the ids here are dummies and never touch a real resource.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "solo-stack-web-local",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations",
			"migrations_pattern": "migrations/*/migration.sql"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "00000000000000000000000000000000"
		}
	],
	// Contact form mails (src/lib/contact/deliver.server.ts) via Cloudflare Email Sending, onboarded for solo-stack.dev.
	// Pinned sender and recipient; business@ is forwarded to the owner's inbox by Email Routing. Locally the binding is
	// simulated (mail printed to the console, nothing sent).
	"send_email": [
		{
			"name": "CONTACT_EMAIL",
			"destination_address": "business@solo-stack.dev",
			"allowed_sender_addresses": ["contact@solo-stack.dev"]
		}
	],
	// Bindings and `vars` are not inherited: repeat them in every environment.
	"env": {
		"staging": {
			"routes": [{ "pattern": "staging.solo-stack.dev", "custom_domain": true }],
			"send_email": [
				{
					"name": "CONTACT_EMAIL",
					"destination_address": "business@solo-stack.dev",
					"allowed_sender_addresses": ["contact@solo-stack.dev"]
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "solo-stack-web-staging",
					"database_id": "3a2bf35c-80d6-4099-8bcd-91e11ecf4896",
					"migrations_dir": "migrations",
					"migrations_pattern": "migrations/*/migration.sql"
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "9811bb0a672143eab3060fe08b8f531f"
				}
			]
		},
		"production": {
			"routes": [{ "pattern": "solo-stack.dev", "custom_domain": true }],
			"send_email": [
				{
					"name": "CONTACT_EMAIL",
					"destination_address": "business@solo-stack.dev",
					"allowed_sender_addresses": ["contact@solo-stack.dev"]
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "solo-stack-web",
					"database_id": "8f3f99f9-1fca-4305-8ea2-0351cacefff9",
					"migrations_dir": "migrations",
					"migrations_pattern": "migrations/*/migration.sql"
				}
			],
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "30915a3709f441728ec41a971122b7ca"
				}
			]
		}
	}
}
