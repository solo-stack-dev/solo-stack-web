# Secrets per environment. Copy this file and fill in real values:
#   .env             local dev only (`pnpm dev`, `pnpm preview`), never uploaded
#   .env.staging     uploaded as Worker secrets by `pnpm staging:deploy`
#   .env.production  uploaded as Worker secrets by `pnpm production:deploy`
# Keys in the deploy files are added/updated on every deploy. Keys you remove are NOT deleted
# remotely (use `wrangler secret delete <KEY> --env <env>`).
# Non-secret config belongs in `vars` in wrangler.jsonc instead.
# Do not put CLOUDFLARE_ENV here: the scripts pass `--env`, and every key in these files is uploaded as a secret.

# EXAMPLE_API_KEY=

# Cloudflare Turnstile secret for the contact form (dashboard > Turnstile > your widget). The public site key lives
# in src/lib/contact/turnstile.ts. Leave it unset in `.env` to use Cloudflare's always-pass test secret locally.
# TURNSTILE_SECRET_KEY=

# /stats collector (workers/stats-collector/, docs/ARCHITECTURE.md "Stats collector setup"). Also uploaded to the
# collector Worker by `pnpm stats:deploy:<env>`; `pnpm stats:dev` reads `.env`.
# YouTube Data API v3 key (Google Cloud > Credentials; application restriction None, API restriction YouTube Data API v3).
YOUTUBE_API_KEY=
# Instagram API with Unified Login: system-user token from the app's Instagram token generator (instagram_basic).
# INSTAGRAM_ACCOUNT_ID lives in workers/stats-collector/wrangler.jsonc vars for each environment; requests use graph.facebook.com.
# Token prefixes do not identify a broken setup. Legacy Instagram Login needs an empty account ID and its own IG token.
INSTAGRAM_ACCESS_TOKEN=
# Threads API: long-lived user token (60 days, the collector refreshes it in KV), permissions threads_basic + threads_manage_insights.
THREADS_ACCESS_TOKEN=
# Twitch app (dev.twitch.tv/console > Applications, client type "Confidential", redirect URL http://localhost:3000).
# The user token comes from `pnpm stats:twitch-login` and lives in KV, not here.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
