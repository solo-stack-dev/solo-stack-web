{
	"name": "solo-stack-web",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"analyze": "vite build --mode analyze",
		"preview": "vite build --mode preview && wrangler dev",
		"staging:deploy": "vite build --mode staging && wrangler deploy --env staging --secrets-file .env.staging",
		"production:deploy": "vite build && wrangler deploy --env production --secrets-file .env.production",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm paraglide:compile && wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm paraglide:compile && wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix && oxfmt",
		"pkg:update": "sfw pnpm update",
		"gen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
		"db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang --silent"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.29.3",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.66.0",
		"@shadcn/lint": "^0.2.4",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@threlte/core": "^8.6.1",
		"@threlte/extras": "^9.23.0",
		"@types/node": "^24.19.2",
		"@types/three": "^0.186.0",
		"bits-ui": "^2.20.3",
		"cn": "^0.5.2",
		"drizzle-kit": "1.0.0-rc.5",
		"drizzle-orm": "1.0.0-rc.5",
		"mdsvex": "^0.12.8",
		"mode-watcher": "^1.1.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.90.0",
		"rolldown": "^1.2.16",
		"sharp": "0.35.5",
		"super-sitemap": "^2.0.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.3",
		"three": "^0.186.1",
		"typescript": "^6.0.3",
		"valibot": "^1.5.0",
		"vite": "^8.3.5",
		"wrangler": "^4.156.2"
	},
	"engines": {
		"node": ">=24.18.0"
	},
	"packageManager": "pnpm@11.13.1"
}
