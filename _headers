# Cloudflare static asset headers. adapter-cloudflare copies this file into the build and appends its own block
# (hashed `/_app/immutable/*` files: one year, immutable). Everything else is served with `max-age=0, must-revalidate`
# by default, i.e. one revalidation round trip per file and navigation. These files are not hashed but never change
# in place:
# - fonts: a changed font gets a new file name (update app.html and layout.css)
# - prerendered video thumbnails: keyed by video id and width, re-encoded only from the same YouTube source
# The blog feeds are prerendered files too, so the type set in their +server.ts is lost: name it here (else application/xml).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/blog/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

/en/blog/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

# Markdown versions of the posts for agents (blog/[slug].md): the HTML page is the indexed one.
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

/llms.txt
  Content-Type: text/plain; charset=utf-8

# RFC 9116 requires this exact type.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
