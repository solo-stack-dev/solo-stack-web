{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 170,
	"svelte": true,
	"sortTailwindcss": {
		"stylesheet": "./src/routes/layout.css"
	},
	// src/content/: mdsvex 1 parses PFM, where `*a*` is bold; a CommonMark formatter would rewrite it to italic `_a_`
	"ignorePatterns": ["src/content/", "pnpm-lock.yaml", "src/lib/paraglide", "worker-configuration.d.ts", "/static/", "docs/mockups/"]
}
